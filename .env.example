# =============================================================================
# Apna Samaan — Environment Configuration Template
# Copy this file to `.env` and fill in your local values.
# NEVER commit `.env` to Git. Keep only placeholder values in `.env.example`.
# =============================================================================

# --- Server & Frontend Origin (Phase 0+) ---
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8080,http://127.0.0.1:8080

# --- MySQL 8 Database (Docker Compose + Spring Boot, Phase 0+) ---
MYSQL_ROOT_PASSWORD=CHANGE_ME_MYSQL_ROOT_PASSWORD
MYSQL_DATABASE=apna_samaan
MYSQL_USER=apna_samaan_app
MYSQL_PASSWORD=CHANGE_ME_MYSQL_APP_PASSWORD
MYSQL_PORT=3306

DB_URL=jdbc:mysql://localhost:3306/apna_samaan?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=apna_samaan_app
DB_PASSWORD=CHANGE_ME_MYSQL_APP_PASSWORD

# --- JWT & Admin Bootstrap (Phase 1+) ---
# Must be at least 32 characters long; app fails on startup in Phase 1+ if shorter
JWT_SECRET=CHANGE_ME_USE_AT_LEAST_32_RANDOM_CHARACTERS_HERE
JWT_ACCESS_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_DAYS=7

ADMIN_EMAIL=shudanshubora1410@gmail.com
ADMIN_PASSWORD=CHANGE_ME_ADMIN_BOOTSTRAP_PASSWORD

# --- Gmail SMTP for Transactional Emails (Phase 1+) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=teamapnasamaan@gmail.com
MAIL_PASSWORD=CHANGE_ME_GMAIL_APP_PASSWORD
FRONTEND_BASE_URL=http://localhost:8080

# --- Driver Document Storage (Phase 2+) ---
# Must point to a directory outside the static web root
FILE_STORAGE_DIR=./uploads/driver-documents

# --- Pricing, Maps & Groq AI Vehicle Suggestion (Phase 3+) ---
PRICING_GST_PERCENT=18.00
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
OSRM_BASE_URL=https://router.project-osrm.org
GROQ_API_KEY=CHANGE_ME_GROQ_API_KEY
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# --- Razorpay Test Mode (Phase 4+) ---
RAZORPAY_KEY_ID=rzp_test_CHANGE_ME
RAZORPAY_KEY_SECRET=CHANGE_ME_RAZORPAY_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=CHANGE_ME_RAZORPAY_WEBHOOK_SECRET
RAZORPAY_SIMULATION_ENABLED=false

# --- Driver Matching & Offer Timeouts (Phase 5+) ---
MATCHING_OFFER_TIMEOUT_SECONDS=60
MATCHING_SEARCH_TIMEOUT_SECONDS=180
MATCHING_SWEEP_INTERVAL_MILLIS=5000
MATCHING_SCHEDULER_ENABLED=true

# --- Google OAuth2 Login for Customers (Phase 7+) ---
# Register http://localhost:8080/api/v1/auth/google/callback under Authorized redirect URIs in Google Cloud Console
GOOGLE_CLIENT_ID=CHANGE_ME_GOOGLE_OAUTH_CLIENT_ID
GOOGLE_CLIENT_SECRET=CHANGE_ME_GOOGLE_OAUTH_CLIENT_SECRET
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/google/callback
